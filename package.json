{
  "name": "truesignal-cli",
  "version": "0.1.4",
  "description": "A provenance-first OSINT/security intelligence feed CLI. Every item ships a real source URL, a real timestamp, and an explicit live/fallback flag -- never a fabricated or silently-replayed data point.",
  "keywords": [
    "osint",
    "security",
    "threat-intelligence",
    "cisa-kev",
    "cve",
    "cli",
    "provenance",
    "cloudflare-radar",
    "gdelt",
    "reddit",
    "telegram",
    "vulnerability-intelligence"
  ],
  "homepage": "https://github.com/RudrenduPaul/truesignal#readme",
  "bugs": {
    "url": "https://github.com/RudrenduPaul/truesignal/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RudrenduPaul/truesignal.git"
  },
  "license": "MIT",
  "author": "Rudrendu Paul",
  "contributors": [
    "Sourav Nandy"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "truesignal": "./dist/cli.js",
    "truesignal-cli": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/truesignal/cli.ts",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit --strict",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "nanoid": "^3.3.17",
    "postcss": "^8.5.26",
    "js-yaml": "^4.3.2"
  }
}
